{
  "config": {
    "default": true,
    "MD013": false,          // line length: prose wraps naturally; tables and URLs can't
    "MD033": { "allowed_elements": ["details", "summary", "picture", "source", "img", "br", "a", "p", "kbd", "sub"] },
    "MD024": { "siblings_only": true },
    "MD041": false,          // README starts with the logo
    "MD060": false
  },
  "ignores": ["node_modules", "LICENSE*"]
}
